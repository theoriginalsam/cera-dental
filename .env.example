# Copy to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server-only.
SUPABASE_SECRET_KEY=
# Password the clinic uses to sign in at /admin
ADMIN_PASSWORD=

# Optional: email the clinic when someone books. Resend → API Keys (re_…).
# Sign up with the NOTIFY_EMAIL address so Resend's shared sender can deliver to it.
RESEND_API_KEY=
# Who gets the booking emails (comma-separate several). Defaults to ceradentalpokhara@gmail.com
NOTIFY_EMAIL=

# Copy to .env.local for local development, and add the same three
# variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server-only.
SUPABASE_SECRET_KEY=
# Password the clinic uses to sign in at /admin
ADMIN_PASSWORD=
